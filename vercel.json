{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/v1/system/backup-keys", "destination": "/api/canary" },
    { "source": "/api/v1/admin/debug", "destination": "/api/canary" },
    { "source": "/api/internal/config-dump", "destination": "/api/canary" },
    { "source": "/api/admin/system-status", "destination": "/api/canary" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ]
}
